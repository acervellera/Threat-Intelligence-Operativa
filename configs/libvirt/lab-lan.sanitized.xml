<!--
  Configurazione pubblica e sanificata della rete host-only TIO.
  Sono stati rimossi UUID, indirizzi MAC e altri metadati locali.
  L'assenza dell'elemento <forward> mantiene la rete isolata.
-->
<network>
  <name>lab-lan</name>
  <bridge name="virbr1" stp="on" delay="0"/>
  <domain name="lab-lan"/>
  <ip address="10.10.10.1" netmask="255.255.255.0"/>
</network>
