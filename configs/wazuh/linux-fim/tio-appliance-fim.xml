<!-- Threat Intelligence Operativa — APPLIANCE-LAB -->
<!-- Integrare una sola volta nei blocchi corretti di ossec.conf. -->

<!-- Dentro <syscheck> -->
<directories check_all="yes" realtime="yes" whodata="yes" report_changes="yes">/opt/tio-appliance-lab/data</directories>

<!-- A livello <ossec_config>; normalmente già presente nel pacchetto Linux -->
<localfile>
  <log_format>audit</log_format>
  <location>/var/log/audit/audit.log</location>
</localfile>

