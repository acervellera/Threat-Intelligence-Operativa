<!--
  Threat Intelligence Operativa
  Regole Wazuh per la telemetria HTTP JSONL di SINKHOLE-LAB.

  Ambiente validato:
    - Wazuh 4.14
    - sorgente requests.jsonl
    - decoder JSON integrato

  Nota: "status" è un campo statico di Wazuh e viene confrontato
  con il tag <status>, non con <field name="status">.
-->
<group name="tio_sinkhole,http,telemetry,">

  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <location type="pcre2">requests\.jsonl$</location>
    <description>TIO sinkhole JSON telemetry grouping.</description>
  </rule>

  <rule id="100101" level="3">
    <if_sid>100100</if_sid>
    <status type="pcre2">^200$</status>
    <field name="path" type="pcre2">^/heartbeat$</field>
    <description>TIO sinkhole heartbeat: $(method) $(path), status $(status), client $(client_ip).</description>
    <group>tio_sinkhole_heartbeat,http_success,</group>
  </rule>

  <rule id="100102" level="5">
    <if_sid>100100</if_sid>
    <status type="pcre2">^404$</status>
    <description>TIO sinkhole unknown path: $(method) $(path), status $(status), client $(client_ip).</description>
    <group>tio_sinkhole_not_found,http_404,</group>
  </rule>

  <rule id="100103" level="7">
    <if_sid>100100</if_sid>
    <status type="pcre2">^405$</status>
    <description>TIO sinkhole method not allowed: $(method) $(path), status $(status), client $(client_ip).</description>
    <group>tio_sinkhole_method_not_allowed,http_405,</group>
  </rule>

</group>
